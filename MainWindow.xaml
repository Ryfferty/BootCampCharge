<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BootCampCharge.MainWindow"
        Title="BootCampCharge"
        Width="420" Height="520"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Closing="OnClosing">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="White"/>
        <SolidColorBrush x:Key="TextDark" Color="#1D1D1F"/>
        <SolidColorBrush x:Key="TextMid" Color="#515154"/>
        <SolidColorBrush x:Key="TextLight" Color="#86868B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#007AFF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#34C759"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <!-- ═══ 电池状态 ═══ -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="0" Width="52" Height="80" Margin="0,0,16,0">
                        <Rectangle Canvas.Left="6" Canvas.Top="2" Width="40" Height="66" RadiusX="5" RadiusY="5"
                                   Stroke="#D1D1D6" StrokeThickness="2" Fill="#FFFFFF"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="0" Width="20" Height="6" RadiusX="3" RadiusY="3" Fill="#D1D1D6"/>
                        <Canvas ClipToBounds="True">
                            <Canvas Canvas.Left="8" Canvas.Top="4" Width="36" Height="62">
                                <Rectangle x:Name="BatteryFill" Canvas.Left="0" Canvas.Top="62" Width="36" Height="0"
                                           RadiusX="3" RadiusY="3">
                                    <Rectangle.Fill>
                                        <SolidColorBrush x:Name="BatteryFillBrush" Color="#34C759"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Canvas>
                        </Canvas>
                        <TextBlock x:Name="BatteryPercentText" Canvas.Left="6" Canvas.Top="30" Width="40"
                                   TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}" Text="--"/>
                    </Canvas>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ChargePercentLabel" Text="--%" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}"/>
                        <TextBlock x:Name="StatusLabel" Text="加载中…" FontSize="12"
                                   Foreground="{StaticResource TextMid}" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TempLabel" Text="" FontSize="11"
                                   Foreground="{StaticResource TextLight}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 电池信息 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="电池信息" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="健康度" Style="{StaticResource SettingDesc}"/>
                            <TextBlock x:Name="HealthLabel" Text="--" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGreen}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="设计容量" Style="{StaticResource SettingDesc}"/>
                            <TextBlock x:Name="DesignCapLabel" Text="-- mWh" FontSize="14"
                                       Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="当前最大容量" Style="{StaticResource SettingDesc}"/>
                            <TextBlock x:Name="FullCapLabel" Text="-- mWh" FontSize="14"
                                       Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="电压" Style="{StaticResource SettingDesc}"/>
                            <TextBlock x:Name="VoltageLabel" Text="-- mV" FontSize="14"
                                       Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <TextBlock Text="适配器" Style="{StaticResource SettingDesc}"/>
                            <TextBlock x:Name="AdapterLabel" Text="--" FontSize="14"
                                       Foreground="{StaticResource TextDark}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="#E5E5EA"/>
                        <Rectangle x:Name="HealthBar" Height="6" RadiusX="3" RadiusY="3" HorizontalAlignment="Left" Width="0">
                            <Rectangle.Fill>
                                <SolidColorBrush x:Name="HealthBarBrush" Color="#34C759"/>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ 充电限制 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="充电限制" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="LimitSlider" Grid.Column="0" Minimum="20" Maximum="100"
                                TickFrequency="5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBox x:Name="LimitInput" Width="36" TextAlignment="Center"
                                     VerticalContentAlignment="Center" FontSize="13"/>
                            <TextBlock Text="%" FontSize="13" VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{StaticResource TextLight}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="设置充电上限后，电池最多充到该百分比后停止充电。此设置由硬件 BCLM 保持，退出程序后仍然生效。"
                               Style="{StaticResource SettingDesc}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 设置 ═══ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机自启" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource TextDark}" VerticalAlignment="Center"/>
                            <TextBlock Text="登录 Windows 时自动启动并应用充电限制"
                                       Style="{StaticResource SettingDesc}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartChk" Grid.Column="1" VerticalAlignment="Center" Margin="8,0"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#E5E5EA" Margin="0,8"/>

                    <TextBlock Text="Boot Camp 下充电限制通过 SMC 的 BCLM 键实现，由 MacBook 固件管理，退出程序后仍然有效。"
                               Style="{StaticResource SettingDesc}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
